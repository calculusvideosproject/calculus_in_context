                </cell>
              </row>
										<row class="odd">
                <cell halign="left">
                  <p>
                    <m>(1 + w^3)^2</m>
                  </p>
					
					<!-- Horizontal Rule Not Implimented -->
                </cell>
											<cell halign="left">
